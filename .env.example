# Runtime
ENVIRONMENT=PROD
FRONTEND_URL=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com
LOG_LEVEL=WARNING
PORT=5005
MAX_CONTENT_LENGTH=104857600
REPORT_SCHEDULER_ENABLED=false
OTP_MODE=production

# Required production secrets (generate unique values; never commit them)
SECRET_KEY=<generate-a-long-random-secret>
JWT_SECRET=<generate-a-different-long-random-secret>
ENCRYPTION_KEY=<existing-compatible-base64-or-hex-32-byte-key>
ENCRYPTION_KEY_FINGERPRINT=<optional-same-non-secret-value-on-render-and-oci>
PROD_DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# Email (required when ENABLE_EMAIL=true)
SMTP_EMAIL=ssjewellerysystem@gmail.com
SMTP_PASSWORD=<smtp-app-password>
REPORT_OWNER_EMAIL=<report-recipient-email>
MAIL_USE_SSL=false

# Feature flags
ENABLE_PAYMENT=true
ENABLE_SMS=true
ENABLE_OTP=true
ENABLE_EMAIL=true
ENABLE_ORDER_CONFIRMATION=true
ENABLE_EMAIL_FORGOT_PASSWORD_OTP=true
ENABLE_EMAIL_ORDER_CONFIRMATION=true
ENABLE_EMAIL_BUY_REQUEST_CONFIRMATION=true
ENABLE_EMAIL_REGISTRATION_OTP=true
EXPOSE_OTP_IN_RESPONSE=false
ENABLE_MOBILE_OTP=false
MOBILE_OTP_PROVIDER=disabled
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS=true
ENABLE_RAPID_API=true

# Optional payment, messaging, and market-data integrations
PROD_RAZORPAY_KEY_ID=<optional>
PROD_RAZORPAY_KEY_SECRET=<optional>
PROD_RAPID_API_KEY=<optional>

# Optional Cloudinary storage (local uploads are used when omitted)
PROD_CLOUDINARY_CLOUD_NAME=<optional>
PROD_CLOUDINARY_API_KEY=<optional>
PROD_CLOUDINARY_API_SECRET=<optional>
CLOUDINARY_CLOUD_NAME=<optional-compatible-alias>
CLOUDINARY_API_KEY=<optional-compatible-alias>
CLOUDINARY_API_SECRET=<optional-compatible-alias>

# Optional OAuth integrations
GOOGLE_CLIENT_ID=<optional>
GOOGLE_CLIENT_SECRET=<optional>
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback
MICROSOFT_CLIENT_ID=<optional>
MICROSOFT_CLIENT_SECRET=<optional>
MICROSOFT_REDIRECT_URI=https://api.example.com/api/auth/microsoft/callback
