        (
            SELECT COUNT(*) FROM (
                SELECT email FROM support_messages
                UNION ALL
                SELECT email FROM support_tickets_archive
            ) sm_all WHERE sm_all.email = u.email
        ) AS `Support Tickets Count`
    FROM users u
    LEFT JOIN delivery_addresses da ON u.id = da.user_id
    
